# App
APP_ENV=development
TIMEZONE=Africa/Lagos
DATABASE_URL=sqlite:///./owobook.db
ALLOWED_WA_IDS=            # optional comma-separated allow-list for the demo
PUBLIC_BASE_URL=           # for ledger links, e.g. https://owobook.onrender.com (Render sets RENDER_EXTERNAL_URL itself)
LINK_SECRET=               # optional: signs ledger links (defaults to WA_APP_SECRET)

# LLM provider selection
LLM_PROVIDER=meta          # meta | baseten | fake
EXTRACTION_PROVIDER=baseten

# Meta Model API
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
META_CHAT_MODEL=muse-spark-1.3
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
META_REASONING_EFFORT=low    # minimal | low | medium | high (Muse Spark always reasons)
LLM_TIMEOUT_SECONDS=45
TRANSCRIBER=meta            # meta | fake

# Baseten (Meta open-weights models)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=              # exact slug from your Baseten Model APIs page

# WhatsApp Cloud API
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v26.0     # current as of Oct 2026 (v21.0 is removed 21 Jan 2027)
WA_REMINDER_TEMPLATE=      # optional approved template name (used outside the 24h window)
#   Its body must have 3 variables: {{1}} trader name, {{2}} number of customers, {{3}} total amount,
#   e.g. "Good morning {{1}} ⏰ {{2}} customer(s) owe you {{3}} that is due or overdue."
#   Add a quick-reply button "Show reminders" — tapping it sends the forwardable drafts.
WA_REMINDER_TEMPLATE_LANG=en

# Reminders
ENABLE_SCHEDULER=true      # run the daily 08:00 Africa/Lagos job inside the web server
REMINDER_HOUR=8
TASK_TOKEN=                # optional: secret for POST /tasks/reminders (for an external cron)
